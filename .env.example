# 이 프로젝트의 Spring Boot 설정(application.properties)이 참조하는 환경변수 목록.
# 실제 값은 커밋하지 말 것. 로컬 실행 시에는 IntelliJ Run/Debug Configuration의
# "Environment variables"에 입력하거나, 셸에서 export 후 ./gradlew bootRun 실행.

# MySQL
DB_PASSWORD=

# Gmail SMTP (앱 비밀번호 사용)
MAIL_USERNAME=
MAIL_PASSWORD=

# Toss Payments
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Google OAuth2 소셜 로그인
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 프론트엔드 dev 서버 주소 (구글 로그인 콜백 리다이렉트용)
FRONTEND_BASE_URL=

# 카카오톡 알림 (관리자 전용)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
